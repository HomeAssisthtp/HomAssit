# Copia este archivo como .env.local y completa los valores de tu proyecto Supabase.
# Sin estas variables, HomeAssist funciona con datos mock (modo demo).
# Después de editar .env.local reinicia `npm run dev`.

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Clave que el ESP32 envía en 'Authorization: Bearer ...' (la misma va en firmware/homeassist_esp32/config.h).
# Con Supabase, su hash SHA-256 debe estar en la tabla private.ingest_keys (ver README.md, "Clave del dispositivo").
DEVICE_API_KEY=
